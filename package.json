{
  "name": "theia",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node server/index.mjs",
    "desktop": "electron electron/main.mjs",
    "dev:release": "node scripts/release-dev.mjs",
    "desktop:release": "node scripts/release-desktop.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "npm run test:client && npm run test:provider-pool",
    "test:client": "node --test --experimental-strip-types tests/client-persistence.test.mjs",
    "test:provider-pool": "node --test --test-concurrency=1 tests/provider-pool.test.mjs",
    "preview": "vite preview",
    "dist:exe": "npm run build && node release-tools/package-portable-exe.mjs",
    "release:index": "node release-tools/update-release-index.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "leaflet": "^1.9.4",
    "lucide-react": "latest",
    "openai": "^7.0.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/leaflet": "^1.9.20",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "^43.2.0",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "latest"
  }
}
