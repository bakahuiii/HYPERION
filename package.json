{
  "name": "theia",
  "private": true,
  "version": "0.4.0",
  "description": "Local-first personal task atlas built from user-exported conversations.",
  "author": "bakahuiii",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node server/index.mjs",
    "desktop": "electron electron/main.mjs",
    "dev:release": "node scripts/release-dev.mjs",
    "desktop:release": "node scripts/release-desktop.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "npm run test:client && npm run test:importer && npm run test:analysis && npm run test:candidates && npm run test:storage && npm run test:utilities && npm run test:archive-store && npm run test:schema && npm run test:recovery && npm run test:provider-pool",
    "test:client": "node --test --experimental-strip-types tests/client-persistence.test.mjs",
    "test:importer": "node --test --experimental-strip-types tests/importer.test.mjs",
    "test:analysis": "node --test --experimental-strip-types tests/conversation-analysis.test.mjs",
    "test:candidates": "node --test --experimental-strip-types tests/candidate-validation.test.mjs",
    "test:storage": "node --test --experimental-strip-types tests/storage.test.mjs",
    "test:utilities": "node --test --experimental-strip-types tests/frontend-utilities.test.mjs",
    "test:archive-store": "node --test tests/archive-store.test.mjs",
    "test:schema": "node --test tests/schema-migrations.test.mjs",
    "test:recovery": "node --test tests/log-recovery.test.mjs",
    "test:provider-pool": "node --test --test-concurrency=1 tests/provider-pool.test.mjs",
    "test:e2e": "playwright test",
    "test:desktop-smoke": "node scripts/desktop-smoke.mjs",
    "test:unpacked-smoke": "node scripts/unpacked-smoke.mjs",
    "preview": "vite preview",
    "dist:exe": "npm run build && node release-tools/package-portable-exe.mjs",
    "dist:installer": "npm run build && electron-builder --win nsis --x64",
    "dist:unpacked": "npm run build && electron-builder --win dir --x64",
    "release:index": "node release-tools/update-release-index.mjs",
    "data:rollback": "node scripts/rollback-data.mjs"
  },
  "build": {
    "appId": "io.github.bakahuiii.theia",
    "productName": "THEIA",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "artifactName": "THEIA-${version}-${arch}-${os}.${ext}",
    "directories": {
      "output": "release-bin/installer"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "release/app-icon.ico",
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "bakahuiii",
      "repo": "THEIA",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "electron-updater": "^6.8.9",
    "leaflet": "^1.9.4",
    "lucide-react": "latest",
    "openai": "^7.0.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "^1.62.1",
    "@types/leaflet": "^1.9.20",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "latest"
  }
}
